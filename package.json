{
  "name": "@victorzinho/musician-website",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "repository": "git@github.com:victorzinho/musician-website",
  "author": "Víctor González <victorzinho@gmail.com>",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "verify": "node scripts/verify.mjs",
    "links": "astro build && linkinator dist --recurse",
    "cv": "node scripts/cv-pdfs.mjs",
    "docs": "rm -rf .docs/astro && git clone --quiet --filter=blob:none --no-checkout https://github.com/withastro/docs.git .docs/astro && git -C .docs/astro checkout --quiet $npm_package_config_astroDocsCommit"
  },
  "config": {
    "astroDocsCommit": "52e538d93d0c430f4bc2dc5901ff999c3cfcd5e0"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/playfair": "5.3.0",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "html-validate": "11.16.2",
    "linkinator": "8.1.0",
    "playwright-core": "1.64.0",
    "schema-dts": "2.1.0",
    "typescript": "6.0.3"
  }
}
