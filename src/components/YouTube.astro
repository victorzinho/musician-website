---
import { youtubeEmbed } from '../youtube';

interface Props {
  /** The video id, `v=` in a YouTube URL. */
  id: string;
  /** Names the embed for screen readers. */
  title: string;
}

const { id, title } = Astro.props;
const caption = Astro.slots.has('default') ? (await Astro.slots.render('default')).trim() : '';
---

<figure>
  <div class="screen">
    <iframe
      class="youtube"
      src={youtubeEmbed(id)}
      title={title}
      loading="lazy"
      allow="encrypted-media; picture-in-picture; fullscreen"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  {caption && <figcaption set:html={caption} />}
</figure>

<style>
  .screen {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }
</style>
