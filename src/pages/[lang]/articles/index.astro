---
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import { articles } from '../../../articles';
import RoleChips from '../../../components/RoleChips.astro';
import { codas, langPaths, localize, strings, type Lang } from '../../../i18n';

export const getStaticPaths = (() => langPaths()) satisfies GetStaticPaths;

const lang = Astro.currentLocale as Lang;
const t = strings[lang];
const list = await articles();
const month = (d: Date) => d.toLocaleDateString(lang, { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<Base lang={lang} title={t.nav.articles} description={t.meta.description.articles} coda={codas.articles}>
  <h1 class="visually-hidden">{t.nav.articles}</h1>
  <p class="intro">{t.articles.intro}</p>

  <hr class="rule" />

  {list.length === 0 && <p class="empty">{t.articles.empty}</p>}
  <ul class="articles">
    {
      list.map(({ id, data }) => (
        <li>
          <p class="heading">
            <a class="title" href={localize(lang, `/articles/${id}/`)}>
              {data.title[lang]}
            </a>
            <RoleChips roles={data.roles} lang={lang} />
          </p>
          <p class="description">
            {data.description[lang]}
            <span class="dash" aria-hidden="true">—</span>
            <time datetime={data.date.toISOString().slice(0, 10)}>{month(data.date)}</time>
          </p>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .intro {
    margin: 0;
  }
  .empty {
    margin: 0.9rem 0;
    font-style: italic;
    color: var(--color-muted);
  }
  .articles:empty {
    display: none;
  }
  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .articles li {
    padding: 0.9rem 0;
  }
  /* Title and its role chips on one line; the chips wrap together. */
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.75rem;
    margin: 0;
  }
  .title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .description {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .dash {
    margin: 0 0.25rem;
  }
  /* The date ends the description, kept on one line. */
  .description time {
    font-style: italic;
    white-space: nowrap;
  }
</style>
