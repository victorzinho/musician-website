---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { codas, langPaths, strings, type Lang } from '../../i18n';

export const getStaticPaths = (() => langPaths()) satisfies GetStaticPaths;

const lang = Astro.currentLocale as Lang;
const t = strings[lang];
---

<Base lang={lang} title={t.nav.contact} description={t.meta.description.contact} coda={codas.contact}>
  <h1>{t.nav.contact}</h1>
  <ContactLinks />
</Base>

<style>
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    color: var(--color-blue);
  }
</style>
