---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import photo from '../../assets/victor-guitar.jpg';
import Base from '../../layouts/Base.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import ListenItem from '../../components/ListenItem.astro';
import type { WebSite } from 'schema-dts';
import { codas, langPaths, locales, strings, type Lang } from '../../i18n';
import { person, personNode } from '../../structured-data';

export const getStaticPaths = (() => langPaths()) satisfies GetStaticPaths;

const lang = Astro.currentLocale as Lang;
const t = strings[lang].home;
const site: WebSite = {
  '@type': 'WebSite',
  name: 'Víctor González',
  url: Astro.url.href,
  inLanguage: locales[lang],
  author: person,
};
const listen = (await getEntry('homeListen', 'homeListen'))!.data;
---

<Base lang={lang} title={strings[lang].meta.homeTitle} description={strings[lang].meta.description.home} coda={codas.home}
  structuredData={[site, await personNode(lang)]}
>
  <section slot="hero" class="hero">
    {/* The header's height, so the hero fills the rest of the screen; it changes with the width and the fonts. */}
    <script is:inline>
      {
        const masthead = document.querySelector('.masthead');
        new ResizeObserver(() =>
          document.documentElement.style.setProperty('--masthead-height', `${masthead.offsetHeight}px`),
        ).observe(masthead);
      }
    </script>
    <Image src={photo} alt="Víctor González playing classical guitar, looking up at a singer"
      widths={[800, 1200, 1600]} sizes="100vw" class="portrait" loading="eager" />
  </section>

  <section class="intro">
    <h1>{t.identity}</h1>
    <p>{t.intro}</p>
  </section>

  <hr />

  <section aria-labelledby="listen">
    <h2 id="listen" class="label">{t.listen}</h2>
    {listen.map((item) => <ListenItem item={item} lang={lang} />)}
  </section>

  <hr />

  <section id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="label">{strings[lang].nav.contact}</h2>
    <ContactLinks />
  </section>
</Base>

<style>
  /* The photo fills the rest of the screen under the header. */
  .hero {
    position: relative;
    height: max(22rem, calc(100svh - var(--masthead-height, 7rem)));
  }
  .portrait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    line-height: 1.12;
    color: var(--color-blue);
  }
  .intro p:last-child {
    margin: 0;
  }
</style>
