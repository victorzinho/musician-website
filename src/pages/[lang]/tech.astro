---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AccentList from '../../components/AccentList.astro';
import ArticleList from '../../components/ArticleList.astro';
import LinkChips, { type LinkChip } from '../../components/LinkChips.astro';
import Quote from '../../components/Quote.astro';
import YouTube from '../../components/YouTube.astro';
import { articleHref, articles, pdfChip } from '../../articles';
import { codas, langPaths, languages, localize, strings, type Lang } from '../../i18n';
import { cvs, profiles } from '../../site';
import { youtubeId } from '../../youtube';

const parts = ['intro', 'how'] as const;
for (const part of parts) {
  for (const l of languages) {
    if (!(await getEntry('tech', `${part}/${l}`))) throw new Error(`no src/content/tech/${part}-${l}.mdx`);
  }
}

export const getStaticPaths = (() => langPaths()) satisfies GetStaticPaths;

const lang = Astro.currentLocale as Lang;
const t = strings[lang];
const text = async (part: (typeof parts)[number]) => (await render((await getEntry('tech', `${part}/${lang}`))!)).Content;
const Intro = await text('intro');
const How = await text('how');

const cv = cvs.find((c) => c.kind === 'engineer')!.pdf[lang];
const github = profiles.find((p) => p.name === 'GitHub')!.url;
/** Shown only once there is one: no placeholder here. */
const quote = (await getCollection('quotes')).find((q) => q.id === 'engineer');

const all = await articles();
const byId = new Map(all.map((article) => [article.id, article]));
const list = (await getEntry('software', 'software'))!.data.map((tool) => {
  const links: LinkChip[] = [
    ...(tool.articles ?? []).map(({ id }): LinkChip => {
      const article = byId.get(id)!;
      if (!article.text) return pdfChip(article, lang);
      return { label: t.tech.labels.article, href: articleHref(article, lang), title: article.data.title[lang] };
    }),
    ...(tool.code ? [{ label: t.tech.labels.code, href: tool.code, external: true }] : []),
  ];
  /** Its first article, else its code, else nothing. */
  return { ...tool, name: typeof tool.name === 'string' ? tool.name : tool.name[lang], links, link: links[0] };
});
const engineering = all.filter((article) => article.data.roles.includes('engineer'));
---

<Base lang={lang} title={t.nav.roles.engineer} description={t.meta.description.tech} coda={codas.tech}>
  <div class="opening">
    <h1>{t.tech.title}</h1>
    <div class="text">
      <Intro />
    </div>
    <p class="availability">{t.tech.availability}</p>
    <p class="links">
      <a class="chip" href={cv} hreflang={lang} target="_blank" data-umami-event="cv" data-umami-event-file={cv.split('/').pop()}>
        {t.tech.cv} <span aria-hidden="true">↗</span>
        <span class="visually-hidden">{t.works.labels.newTab}</span>
      </a>
      <a class="chip" href={github}>GitHub <span aria-hidden="true">↗</span></a>
      <a class="chip" href={localize(lang, '/contact/')}>{t.nav.contact}</a>
    </p>
  </div>

  {
    list.length > 0 && (
      <>
        <hr />

        <section aria-labelledby="software">
          <h2 id="software">{t.tech.software.title}</h2>
          <p class="lead">{t.tech.software.intro}</p>
          {list.map(({ id, name, description, video, links, link }) => (
            <section class="tool" id={id} aria-label={name}>
              <p class="line">
                <span class="name">
                  {link ? (
                    <a href={link.href} target={link.external ? '_blank' : undefined}>
                      {name}
                    </a>
                  ) : (
                    name
                  )}
                </span>{' '}
                <span aria-hidden="true">·</span> {description[lang]} <LinkChips links={links} lang={lang} />
              </p>
              {video && <YouTube id={youtubeId(video)!} title={name} />}
            </section>
          ))}
        </section>
      </>
    )
  }

  <hr class="rule" />

  <section aria-labelledby="how" class:list={['how', { quoted: quote }]}>
    <h2 id="how">{t.tech.how}</h2>
    <div class="text">
      <How components={{ ul: AccentList }} />
    </div>
    {quote && <Quote id="engineer" lang={lang} />}
  </section>

  {
    engineering.length > 0 && (
      <>
        <hr class="rule" />
        <section aria-labelledby="articles">
          <h2 id="articles">
            <a href={localize(lang, '/articles/')}>{t.nav.articles}</a>
          </h2>
          <ArticleList list={engineering} lang={lang} roles={false} />
        </section>
      </>
    )
  }

  <hr class="rule" />
  <p class="contact">
    {t.tech.contact.text} <a href={localize(lang, '/contact/')}>{t.tech.contact.link} →</a>
  </p>
</Base>

<style>
  /* The claim, then the pitch, then what to do with it: availability, the CV and contact. */
  .opening h1 {
    margin: 1rem 0 1rem;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    line-height: 1.15;
  }
  .opening .text :global(p) {
    margin: 0 0 0.9rem;
  }
  .availability {
    margin: 1.25rem 0 0;
    font-style: italic;
    color: var(--color-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.6rem 0 0;
  }
  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }
  h2 a {
    text-decoration: none;
  }
  .lead {
    margin: 0;
    font-style: italic;
  }
  /* One per tool: a line with its name, what it is and its chips, then its demo. */
  .tool {
    margin-top: 2rem;
  }
  .tool :global(figure) {
    margin: 0.75rem 0 0;
  }
  .line {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: var(--color-ink);
  }
  .name a {
    text-decoration: none;
  }
  /* The text and, once there is one, the quote beside it as a note; under it on narrow screens. */
  .how .text {
    font-size: 1rem;
  }
  .how .text :global(ul) {
    margin: 0;
  }
  .how.quoted {
    display: grid;
    grid-template-columns: 1fr 15rem;
    gap: 0 2rem;
    align-items: start;
  }
  .how.quoted h2 {
    grid-column: 1 / -1;
  }
  .contact {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .how.quoted {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
